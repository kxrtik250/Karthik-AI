# Backend environment variables
# Copy this file to .env before running the backend.
# NEVER commit .env to version control.

DATABASE_URL=postgresql+asyncpg://karthik_ai:karthik_ai_dev@localhost:5432/karthik_ai_db
TEST_DATABASE_URL=postgresql+asyncpg://karthik_ai:karthik_ai_dev@localhost:5432/karthik_ai_test
APP_NAME=Karthik AI
DEBUG=true

# ---------- Documents & Embeddings ----------
UPLOAD_DIR=../uploads/documents
MAX_FILE_SIZE_MB=25
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ---------- LLM & RAG (Phase 4) ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.50
